# =============================================================
# GestDeck — .gitignore
# =============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST

# Entornos virtuales
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ---- Node / Electron / Vite ----
app/node_modules/
app/dist/
app/dist-electron/
app/release/
app/.vite/
app/out/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- Modelos entrenados y pesos (regenerables, pesados) ----
core/models/*.h5
core/models/*.keras
core/models/*.tflite
core/models/*.onnx
core/models/*.pb
core/models/*.version
core/models/*.task

# ---- Datasets y capturas de entrenamiento (datos personales) ----
training/dataset/*.csv
training/dataset/*.npy
training/dataset_inapp/
training/dataset_inapp_v*/
training/dataset_*/

# ---- Sesiones con datos del usuario ----
sessions/*/backup_*/
sessions/*/cache/
sessions/*/.tmp/

# ---- Configuración local / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ---- Claude Code (config local del agente) ----
.claude/

# ---- Variables de entorno y secretos ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- Logs y temporales ----
*.log
logs/
*.tmp
*.bak
*.old

# ---- Sistema operativo ----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Archivos grandes / binarios sueltos ----
*.zip
*.tar.gz
*.7z
*.rar

# ---- Documentos de exposición / entregables académicos (no van al repo) ----
*.docx
*.doc
*.pdf
docs/FUNDAMENTO_TECNICO.md
docs/_md_to_docx.py

# ---- GestDeck Deep Learning Exclusions ----
prodeep/
training/dataset/*/
*.keras

# ---- Videos de prueba ----
prueba/*.mp4
prueba/*.avi
prueba/*.mov
prueba/*.mkv
