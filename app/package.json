{
  "name": "gestdeck-app",
  "version": "0.1.0",
  "private": true,
  "description": "GestDeck — Modo Virtual (Ghost Mode) — Electron + React frontend",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm:vite\" \"wait-on tcp:5173 && electron .\"",
    "vite": "vite",
    "build:web": "vite build",
    "build": "npm run build:web && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gestdeck.app",
    "productName": "GestDeck",
    "files": ["main.js", "preload.js", "dist/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "nsis" }
  }
}
